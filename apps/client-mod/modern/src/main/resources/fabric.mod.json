{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "license": "${license}",
  "icon": "assets/bloomclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.bloom.client.fabric.BloomFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${min_loader}",
    "fabric-api": "*",
    "minecraft": ">=${mc_min} <${mc_below}",
    "java": ">=${java_release}"
  },
  "breaks": {
    "optifabric": "*"
  }
}
