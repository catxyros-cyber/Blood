# BLOOD API configuration. Copy to .env and fill in. Never commit real values.
# Development and production must use separate Stripe modes: the server refuses
# live keys outside production and test keys in production.

# development | production
BLOOM_ENV=development
PORT=8787
# Public https URL of this server (website + API) in production.
PUBLIC_URL=http://localhost:8787
# Set to 1 when running behind a reverse proxy/load balancer that sets X-Forwarded-For/Proto.
TRUST_PROXY=0

# PostgreSQL 14+. Leave empty in development to use a temporary in-memory store.
DATABASE_URL=postgres://bloom:CHANGE_ME@localhost:5432/bloom
# Apply migrations automatically on start (1) or run `npm run migrate` yourself (0).
MIGRATE_ON_START=1

# --- Stripe (https://dashboard.stripe.com/apikeys) ---------------------------
# Test mode key (sk_test_…) for development; live key (sk_live_…) only in production.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Signing secret of your webhook endpoint (https://dashboard.stripe.com/webhooks).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Price ids for the plans you sell. Omit a plan to hide it.
STRIPE_PRICE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_YEARLY=price_REPLACE_ME
STRIPE_PRICE_LIFETIME=
# Pinned Stripe API version (create the webhook endpoint with the same version).
STRIPE_API_VERSION=2024-06-20
# Only for a staging server that runs with BLOOM_ENV=production on test keys.
STRIPE_ALLOW_TEST_KEYS=0

# --- Releases / auto-update -------------------------------------------------
# Tauri updater manifest produced by the release workflow (latest.json): https URL or file path.
RELEASE_MANIFEST=https://github.com/OWNER/REPO/releases/latest/download/latest.json

# Days a launcher sign-in stays valid.
SESSION_DAYS=90

# --- License keys -------------------------------------------------------------
# Password for the key admin page (https://YOUR-SERVER/admin.html) where you create
# Premium keys. At least 24 random characters. Leave empty to turn the admin page off.
ADMIN_TOKEN=
