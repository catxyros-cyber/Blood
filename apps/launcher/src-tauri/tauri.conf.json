{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BLOOD",
  "mainBinaryName": "BLOOD",
  "version": "1.0.14",
  "identifier": "com.bloodlauncher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MOTION MOTION",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0a0708"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: data: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "BLOOD",
    "copyright": "© 2026 MOTION MOTION. Not affiliated with Mojang Studios or Microsoft.",
    "category": "Game",
    "shortDescription": "Built for frames.",
    "longDescription": "MOTION MOTION is a black-and-green, performance-focused Minecraft: Java Edition launcher with built-in HUD mods, Modrinth mod browsing, multiple installations and reversible optimization presets.",
    "homepage": "https://bloodlauncher.example",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/bloomclient/": "bloomclient/"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_YOUR_TAURI_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/OWNER/REPO/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
