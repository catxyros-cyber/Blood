{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for BLOOD's main window. Filesystem, network and process access go through BLOOD's own audited commands (see src/), not the generic plugins.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "process:allow-restart",
    "updater:default"
  ]
}
