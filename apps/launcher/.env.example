# Launcher build-time configuration. Copy to apps/launcher/.env (or set in CI).
# These values end up inside the shipped app, so they must not be secrets.

# Azure app registration (client) id for Microsoft sign-in. See docs/MICROSOFT_AUTH.md.
VITE_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Public URL of your BLOOD API/website. Leave empty to build without online features (Premium, sync, announcements).
# Its host is automatically added to the launcher's network allowlist at build time.
VITE_BLOOM_API_URL=https://bloomlauncher.example

# Contact info sent in the User-Agent to Modrinth and other APIs (read by the Rust build).
# Modrinth asks for this, e.g. "github.com/you/bloom" or "support@bloomlauncher.example".
BLOOM_CONTACT=support@bloomlauncher.example
